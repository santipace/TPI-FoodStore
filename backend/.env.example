# Conexion a la base de datos.
# PostgreSQL (recomendado): crear antes la base foodstore_db
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Alternativa para desarrollo local con SQLite (descomentar y comentar la linea de arriba):
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT (minimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173
